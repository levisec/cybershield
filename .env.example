# CyberShield Environment Variables

# Supabase Integration (Get from Supabase Dashboard > Project Settings > API)
# Leave blank to run CyberShield in high-fidelity offline/client-demo mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI Provider (Defensive Cybersecurity Assistant)
# The application remains fully functional with rule-based heuristics if empty!
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# Optional Threat Intelligence
VITE_VIRUSTOTAL_API_KEY=
